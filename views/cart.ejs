<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans min-h-screen">

  <!-- Top Navbar -->
  <nav class="w-full flex justify-between items-center px-10 py-5 bg-white shadow-sm border-b">
    <h3 class="text-2xl font-bold tracking-tight">Scatch</h3>
    <div class="flex gap-6 items-center">
      <a href="/shop" class="text-sm font-medium hover:text-gray-600 transition">Shop</a>
      <a href="/cart" class="text-sm font-bold text-blue-600">Cart (<%= user.cart ? user.cart.length : 0 %>)</a>
      <a href="/users/logout" class="text-sm font-medium text-red-500 hover:text-red-700 transition">Logout</a>
    </div>
  </nav>

  <!-- Flash Messages -->
  <div class="max-w-6xl mx-auto mt-4 px-5">
    <% if (error && error.length > 0) { %>
      <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200"><%= error %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 border border-green-200"><%= success %></div>
    <% } %>
  </div>

  <!-- Cart Content -->
  <div class="max-w-6xl mx-auto py-8 px-5">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Shopping Cart</h1>

    <% if (!user.cart || user.cart.length === 0) { %>
      <div class="bg-white p-10 rounded-xl shadow-sm text-center border">
        <h2 class="text-xl font-semibold text-gray-700 mb-2">Your cart is empty</h2>
        <a href="/shop" class="inline-block bg-black text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-gray-800 transition mt-4">Continue Shopping</a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Item List -->
        <div class="lg:col-span-2 space-y-4">
          <% user.cart.forEach(function(item) { %>
            <div class="flex items-center justify-between bg-white p-4 rounded-xl shadow-sm border">
              <div class="flex items-center space-x-4">
                <div class="w-20 h-20 rounded-lg flex items-center justify-center overflow-hidden bg-[<%= item.bgcolor %>]">
                  <% if (item.image) { %>
                    <img class="h-full w-full object-cover" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="<%= item.name %>">
                  <% } %>
                </div>
                <div>
                  <h2 class="text-lg font-bold text-gray-800"><%= item.name %></h2>
                  <p class="text-sm text-gray-500">₹ <%= item.price %></p>
                </div>
              </div>
              <a href="/removefromcart/<%= item._id %>" class="text-red-500 hover:text-red-700 text-sm font-semibold">Remove</a>
            </div>
          <% }); %>
        </div>

        <!-- Price Details & Checkout Form -->
        <div class="bg-white p-6 rounded-xl shadow-sm border h-fit space-y-6">
          <h2 class="text-xl font-bold text-gray-800 border-b pb-3">Price Details</h2>
          <div class="space-y-3 text-sm text-gray-600">
            <div class="flex justify-between"><span>Total Price</span><span class="font-medium text-gray-800">₹ <%= total %></span></div>
            <div class="flex justify-between text-green-600"><span>Discount</span><span class="font-medium">- ₹ <%= discount %></span></div>
            <div class="flex justify-between"><span>Shipping Fee</span><span class="font-medium text-gray-800">₹ <%= shipping %></span></div>
            <div class="border-t pt-3 flex justify-between font-bold text-lg text-gray-900"><span>Total Bill</span><span>₹ <%= bill %></span></div>
          </div>

          <form action="/checkout" method="POST" class="space-y-4 border-t pt-4">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Phone Number</label>
              <input type="tel" name="phone" placeholder="9876543210" required class="w-full border p-2.5 rounded-lg text-sm outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Delivery Address</label>
              <textarea name="address" rows="2" placeholder="Street, City, Pincode" required class="w-full border p-2.5 rounded-lg text-sm outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <!-- Payment Method Selection -->
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-2">Payment Method</label>
              <div class="flex gap-4">
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="radio" name="paymentMethod" value="COD" checked onclick="togglePaymentFields(false)">
                  Cash on Delivery
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="radio" name="paymentMethod" value="Online" onclick="togglePaymentFields(true)">
                  Online Payment
                </label>
              </div>
            </div>

            <!-- Dynamic Online Payment Inputs -->
            <div id="onlinePaymentFields" class="hidden space-y-3 bg-gray-50 p-3 rounded-lg border">
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Card Number</label>
                <input type="text" id="cardNumber" name="cardNumber" maxlength="16" placeholder="1234 5678 9012 3456" class="w-full border p-2.5 rounded-lg text-sm outline-none focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Card PIN / CVV</label>
                <input type="password" id="cardPin" name="cardPin" maxlength="4" placeholder="****" class="w-full border p-2.5 rounded-lg text-sm outline-none focus:ring-2 focus:ring-blue-500">
              </div>
            </div>

            <button type="submit" class="w-full bg-black text-white py-3 rounded-lg font-bold hover:bg-gray-800 transition shadow-md">
              Place Order (₹<%= bill %>)
            </button>
          </form>
        </div>

      </div>
    <% } %>
  </div>

  <script>
    function togglePaymentFields(isOnline) {
      const fields = document.getElementById('onlinePaymentFields');
      const cardNumber = document.getElementById('cardNumber');
      const cardPin = document.getElementById('cardPin');

      if (isOnline) {
        fields.classList.remove('hidden');
        cardNumber.required = true;
        cardPin.required = true;
      } else {
        fields.classList.add('hidden');
        cardNumber.required = false;
        cardPin.required = false;
        cardNumber.value = '';
        cardPin.value = '';
      }
    }
  </script>
</body>
</html>