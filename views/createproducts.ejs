<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Add Product</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">

  <nav class="bg-white p-4 shadow flex justify-between items-center px-8">
    <h1 class="text-xl font-bold text-gray-800">Admin Panel</h1>
    <a href="/owner/admin" class="text-blue-600 font-semibold hover:underline">&larr; Back to Dashboard</a>
  </nav>

  <div class="max-w-xl mx-auto my-8 p-6 bg-white rounded-xl shadow-md border">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Create New Product</h2>

    <% if (typeof success !== 'undefined' && success.length > 0) { %>
      <div class="bg-green-500 text-white p-3 rounded-lg mb-6 text-center font-medium">
        <%= success %>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="bg-red-500 text-white p-3 rounded-lg mb-6 text-center font-medium">
        <%= error %>
      </div>
    <% } %>

    <form action="/products/create" method="POST" enctype="multipart/form-data" class="space-y-4">
      
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Product Photo</label>
        <input type="file" name="image" required class="w-full border p-2 rounded-lg bg-gray-50 focus:outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Product Name</label>
        <input type="text" name="name" placeholder="e.g. Leather Bag" required class="w-full border p-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-black">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Price (₹)</label>
          <input type="number" name="price" placeholder="1000" required class="w-full border p-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-black">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Discount (₹)</label>
          <input type="number" name="discount" placeholder="100" value="0" class="w-full border p-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-black">
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3 pt-2">
        <div>
          <label class="block text-xs font-semibold text-gray-600">Card BG Color</label>
          <input type="text" name="bgcolor" placeholder="#ffffff" class="w-full border p-2 rounded-lg text-sm mt-1">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600">Panel BG Color</label>
          <input type="text" name="panelcolor" placeholder="#f9fafb" class="w-full border p-2 rounded-lg text-sm mt-1">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600">Text Color</label>
          <input type="text" name="textcolor" placeholder="#111827" class="w-full border p-2 rounded-lg text-sm mt-1">
        </div>
      </div>

      <button type="submit" class="w-full bg-black hover:bg-gray-800 text-white font-bold py-3 rounded-lg transition-colors mt-6">
        Add Product to Store
      </button>
    </form>
  </div>

</body>
</html>