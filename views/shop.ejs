<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Scatch - Shop</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

  <!-- ================= NAVBAR ================= -->
  <nav class="bg-white px-6 md:px-8 py-4 flex justify-between items-center shadow-sm border-b sticky top-0 z-50">

    <!-- Logo -->
    <a href="/shop"
       class="text-2xl font-bold tracking-tight text-gray-900">
      Scatch
    </a>

    <!-- Navigation -->
    <div class="flex items-center gap-3 md:gap-6">

      <a href="/shop"
         class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition">
        Shop
      </a>

      <a href="/cart"
         class="text-sm font-semibold text-gray-700 hover:text-indigo-600 transition">
        Cart
      </a>

      <a href="/owner/admin"
         class="text-sm font-semibold text-purple-600 hover:text-purple-800 transition">
        + Add Items
      </a>

      <a href="/users/logout"
         class="text-sm font-semibold text-red-600 border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50 transition">
        Logout
      </a>

    </div>
  </nav>


  <!-- ================= MAIN ================= -->

  <main class="max-w-7xl mx-auto px-6 py-8">

    <!-- Success Message -->
    <% if (typeof success !== 'undefined' && success.length > 0) { %>

      <div class="bg-green-500 text-white p-3 rounded-lg mb-6 text-center font-medium shadow">
        <%= success %>
      </div>

    <% } %>


    <!-- Error Message -->
    <% if (typeof error !== 'undefined' && error.length > 0) { %>

      <div class="bg-red-500 text-white p-3 rounded-lg mb-6 text-center font-medium shadow">
        <%= error %>
      </div>

    <% } %>


    <!-- ================= HEADER ================= -->

    <div class="flex items-center justify-between mb-8">

      <h2 class="text-3xl font-extrabold text-gray-900">
        Shop Collection
      </h2>

      <span class="text-sm text-gray-500 font-medium">

        <%= products ? products.length : 0 %> Items

      </span>

    </div>


    <!-- ================= PRODUCTS ================= -->

    <% if (!products || products.length === 0) { %>

      <!-- No Products -->
      <div class="bg-white p-12 rounded-xl shadow-sm border text-center">

        <p class="text-lg text-gray-500">
          No products available in store right now.
        </p>

      </div>

    <% } else { %>


      <!-- Product Grid -->

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

        <% products.forEach(function(product) { %>

          <div
            class="bg-white rounded-xl border shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden group"
          >

            <!-- ================= IMAGE ================= -->

            <div>

              <div
                class="w-full h-56 flex items-center justify-center p-3 relative bg-gray-50"
              >

                <!-- Discount Badge -->

                <% if (product.discount && Number(product.discount) > 0) { %>

                  <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow z-10">

                    ₹<%= product.discount %> OFF

                  </span>

                <% } %>


                <!-- Product Image -->

                <% if (product.image) { %>

                  <img
                    class="h-full w-full object-cover rounded-lg group-hover:scale-105 transition-transform duration-300"
                    src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                    alt="<%= product.name %>"
                  >

                <% } else { %>

                  <div class="text-gray-400 text-sm font-medium">
                    No Image Uploaded
                  </div>

                <% } %>

              </div>


              <!-- ================= PRODUCT DETAILS ================= -->

              <div class="p-5">

                <h3 class="text-lg font-bold text-gray-900 truncate mb-1">

                  <%= product.name %>

                </h3>


                <!-- Price -->

                <div class="flex items-baseline gap-2 mt-2">

                  <% if (product.discount && Number(product.discount) > 0) { %>

                    <span class="text-xl font-black text-indigo-600">

                      ₹<%= Number(product.price) - Number(product.discount) %>

                    </span>


                    <span class="text-sm text-gray-400 line-through">

                      ₹<%= product.price %>

                    </span>

                  <% } else { %>

                    <span class="text-xl font-black text-indigo-600">

                      ₹<%= product.price %>

                    </span>

                  <% } %>

                </div>

              </div>

            </div>


            <!-- ================= ADD TO CART ================= -->

            <div class="p-5 pt-0">

              <a
                href="/addtocart/<%= product._id %>"
                class="w-full inline-block text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-colors shadow-sm"
              >

                Add to Cart

              </a>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </main>

</body>
</html>